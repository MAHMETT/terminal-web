{
  "name": "terminal-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A web-based terminal (xterm.js + node-pty) that runs your shell inside tmux for resumable sessions.",
  "license": "MIT",
  "author": "AaronFei",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bun esbuild.mjs",
    "start": "bun src/server.ts",
    "lint": "oxlint src web",
    "postinstall": "bun scripts/fix-pty-perms.mjs"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.14",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.21.5",
    "lefthook": "^1.11.0",
    "oxlint": "^0.16.0",
    "typescript": "^5.4.5"
  }
}
