# Copy this file to .env and customize as needed.
# Loaded by scripts/start.sh and scripts/dev.sh (not by `bun start` directly).

# TCP port the HTTP/WebSocket server listens on.
PORT=8090

# Host/IP to bind to. Default: auto-detect Tailscale IPv4, else 0.0.0.0.
# HOST=192.168.1.50

# Default tmux session name when the client doesn't pass ?session=NAME.
# DEFAULT_SESSION=web

# Shared token for auth (e.g. behind Cloudflare). Empty = no auth.
# AUTH_TOKEN=

# Where uploaded files are saved (default: ~/terminal-web-uploads).
# UPLOAD_DIR=~/terminal-web-uploads

# Auto-delete uploads older than this many hours (0 = never). Default: 72.
# UPLOAD_RETENTION_HOURS=72

# Max uploaded files to keep (0 = unlimited). Default: 100.
# UPLOAD_MAX_FILES=100

# Max single upload size in MB (0 = no limit). Default: 25.
# UPLOAD_MAX_MB=25
